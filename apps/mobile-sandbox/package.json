    "android": "expo start --android"
  },
  "dependencies": {
    "expo": "~57.0.0",
    "react": "19.2.3",
    "react-native": "0.86.0"
  },
  "devDependencies": {"typescript":"5.8.3","@types/react":"^19.2.0"},
  "engines":{"node":">=22.13.0"}
