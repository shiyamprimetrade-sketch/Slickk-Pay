# COPY TO PRIVATE HOST ENVIRONMENT, NEVER COMMIT REAL VALUES
SLICKK_ENV=staging
SLICKK_ENABLE_CHECKOUTS=false
SLICKK_GATEWAY_LIVE=false
SLICKK_REGULATORY_SIGNOFF=false
SLICKK_PUBLIC_BASE_URL=https://payments.example.com
SLICKK_CALLBACK_PREFIX=/v1/payments
SLICKK_MERCHANT_API_KEY=REPLACE_WITH_A_RANDOM_64_CHARACTER_SECRET
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_IS_SANDBOX=true
SSLCOMMERZ_STORE_PASSWD=
# Legacy alias SSLCOMMERZ_STORE_PASSWORD is also supported; do not configure contradictory values.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME

# Optional private PostgreSQL SELECT-only reporting connection
DATABASE_READ_URL=
